{
  "name": "polychronicle",
  "version": "1.0.0",
  "private": true,
  "description": "PolyChronicle \u2014 short low-poly history films, researched with Gemini and Google Search and animated entirely in code.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "test:unit": "node --import tsx scripts/validate-models.ts && node --import tsx scripts/test-navigation.ts && node --import tsx scripts/test-world-schema.ts && node --test scripts/test-production-config.mjs && node --import tsx scripts/test-soundtrack.ts && node --import tsx scripts/test-structure-state.ts && node --import tsx scripts/test-animation-pivot.ts && node --import tsx scripts/test-truss.ts && node --import tsx scripts/test-camera-framing.ts && node --import tsx scripts/test-scene-effects.ts && node --import tsx scripts/test-motion-keyframes.ts",
    "test:audit": "node --env-file=.env.local --import tsx scripts/test-moderation-audit.ts",
    "test:backend": "node --env-file=.env.local scripts/test-backend.mjs",
    "test:film": "node --import tsx scripts/test-generated-film.ts",
    "bench:builder": "node --env-file=.env.local --import tsx scripts/bench-builder.ts",
    "visual:build": "node tools/visual-harness/build.mjs",
    "visual:serve": "node tools/visual-harness/serve.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:check": "node --env-file=.env.local scripts/check-tigerdata.mjs",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.mjs",
    "gemini:check": "node --env-file=.env.local scripts/verify-google-backend.mjs",
    "secrets:check": "node --env-file-if-exists=.env.local scripts/check-repo-secrets.mjs",
    "assets:fonts": "node scripts/build-fonts.mjs",
    "assets:landmask": "node scripts/build-landmask.mjs",
    "release:check": "node --env-file-if-exists=.env.local scripts/check-production-config.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@react-three/fiber": "^9.8.2",
    "@vercel/functions": "3.6.1",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.1",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  }
}
