# Server-only. Never prefix these credentials with NEXT_PUBLIC_.
GEMINI_API_KEY=
# vertex (default) for an Express-mode key; developer for an AI Studio key.
GEMINI_PROVIDER=vertex
# Both production models are served from global, us and eu. Vertex Express
# stays in us-central1 unless this is the key's project id or number.
GEMINI_PROJECT=
GEMINI_LOCATION=global
# Research, moderation, the model plan, and the fallback when a build times out.
# Thinking is low. minimal is rejected by gemini-3.8-flash and returns an error.
GEMINI_FAST_MODEL=gemini-3.8-flash
# Used only when GEMINI_FAST_MODEL is unset. Keep it on the same Flash model.
GEMINI_MODEL=gemini-3.8-flash
# Storyboard, and the default for geometry and the draft review.
GEMINI_CREATIVE_MODEL=gemini-4-argon
# Optional overrides. Unset means the defaults in lib/server/models.ts.
# GEMINI_PLANNER_MODEL=gemini-3.8-flash
# GEMINI_BUILDER_MODEL=gemini-4-argon
# GEMINI_ARTICULATED_MODEL=gemini-4-argon
# GEMINI_REVIEW_MODEL=gemini-4-argon
# Narration: the text-to-speech model and one of its prebuilt voices.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Charon
# The director's reference films are kept in a Gemini context cache for 2 hours
# at a time, so each storyboard request sends only its own film. Set to off to
# send them inline with every request instead.
# GEMINI_REFERENCE_CACHE=off

DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:PORT/tsdb
# Local and release migrations only. Do not set this in the hosted runtime.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:PORT/tsdb
# TigerData free-tier TLS: pinned CA PEM with literal \n between lines.
DATABASE_CA_CERT=
# Production canonical origin, for example https://your-project.vercel.app
APP_URL=

# Public deployment metadata. Set real values before public launch.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
