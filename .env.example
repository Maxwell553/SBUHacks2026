# Server-only. Never prefix these credentials with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# vertex (default) for the existing Express-mode key; developer for AI Studio keys.
GEMINI_PROVIDER=vertex
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:PORT/tsdb
# Local/release migrations only; do not add this admin URL to Vercel runtime.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:PORT/tsdb
# For TigerData free-tier TLS: pinned CA PEM with literal \n between lines.
DATABASE_CA_CERT=
# Production canonical URL, e.g. https://your-project.vercel.app
APP_URL=

# Public deployment metadata. Set real values before public launch.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=

# gemini-4-argon is served from the global/us/eu Vertex locations, which need the key's project.
GEMINI_PROJECT=
GEMINI_LOCATION=global
# The model that creates each film (plan, geometry, storyboard). Planner and builder default to it.
GEMINI_CREATIVE_MODEL=gemini-4-argon
# Fast research and safety checks.
GEMINI_FAST_MODEL=gemini-3.5-flash
